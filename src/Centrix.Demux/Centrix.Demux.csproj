<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Centrix.Demux</RootNamespace>
    <AssemblyName>Centrix.Demux</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Centrix.Tests" />
  </ItemGroup>

  <!-- Demultiplexing of staggered (overlapping-window) linear ion trap profile acquisitions, solved
