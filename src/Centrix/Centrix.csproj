<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Centrix.Cli</RootNamespace>
    <AssemblyName>centrix</AssemblyName>
    <Description>Centroids (and demultiplexes) linear ion trap profile data with Centrix; reads Thermo .raw and mzML and writes mzML.</Description>
    <!-- The Thermo SDK constructs CultureInfo("en-US") itself. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Centrix.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Centrix.Core\Centrix.Core.csproj" />
    <ProjectReference Include="..\Centrix.Demux\Centrix.Demux.csproj" />
    <ProjectReference Include="$(PwizRepoRoot)pwiz\utility\Util.csproj" />
    <ProjectReference Include="$(PwizRepoRoot)pwiz\data\common\Common.csproj" />
    <ProjectReference Include="$(PwizRepoRoot)pwiz\data\msdata\MsData.csproj" />
    <ProjectReference Include="$(PwizRepoRoot)pwiz\analysis\Analysis.csproj" />
    <ProjectReference Include="$(PwizRepoRoot)pwiz\data\vendor_readers\Common\Vendor.Common.csproj" />
  </ItemGroup>

  <!-- Thermo's is the one vendor reader: Centrix reads Thermo .raw and ProteoWizard's open formats.
       It always builds, so a .raw is identified; without the vendor-license agreement reading one
       fails with "vendor support not enabled". (A vendor build also builds Waters' reader, which
       ProteoWizard's lock-mass filter in Analysis needs; Centrix does not register it.) -->
  <ItemGroup>
    <ProjectReference Include="$(PwizRepoRoot)pwiz\data\vendor_readers\Thermo\Thermo.csproj" />
  </ItemGroup>

</Project>
